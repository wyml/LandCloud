# ===== Supabase =====
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# 仅服务端使用，严禁泄露到客户端
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===== 管理员 =====
# 唯一管理员邮箱（Supabase Auth 中对应的账号）
ADMIN_EMAIL=admin@example.com

# ===== S3 兼容对象存储（如 Cloudflare R2 / AWS S3 / MinIO） =====
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=landcloud
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
# 直链公网域名前缀（可指向 CDN），如 https://cdn.example.com
S3_PUBLIC_BASE=https://cdn.example.com

# ===== 站点 =====
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 站点显示名称（可被后台 site_settings 覆盖）
NEXT_PUBLIC_SITE_NAME=LandCloud
# 用于签发访客相册访问凭证的签名密钥（请更换为随机长字符串）
SESSION_SECRET=change-me-to-a-long-random-string

# ===== Cesium（M7 使用） =====
NEXT_PUBLIC_CESIUM_ION_TOKEN=
